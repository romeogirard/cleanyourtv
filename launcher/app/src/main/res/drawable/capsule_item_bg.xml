<?xml version="1.0" encoding="utf-8"?>
<!-- Fork de Romeo : bouton dans la capsule. Focus = cercle blanc, sélectionné (Accueil) = voile clair. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="#F5FFFFFF" /><corners android:radius="19dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle"><solid android:color="#596EC1FF" /><corners android:radius="19dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle"><solid android:color="#38FFFFFF" /><corners android:radius="19dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="19dp" /></shape>
    </item>
</selector>
